# Supabase project settings — Project Settings -> API in the Supabase dashboard.

# Used by the React client (src/api/supabaseClient.js). VITE_-prefixed vars
# are bundled into the browser build, so only put the anon/public key here —
# never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by scripts/seed.js (a one-off Node script, never bundled for the
# browser). The service-role key bypasses Row Level Security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
