    "express": "latest",
    "cors": "latest",
    "better-sqlite3": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.4.2"
  }
